<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.WisataJogja.Brand" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textColor">@color/gold</item>
    </style>

    <style name="TextAppearance.WisataJogja.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/playfair_semibold</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textColor">@color/green_dark</item>
        <item name="android:lineSpacingMultiplier">0.96</item>
    </style>

    <style name="TextAppearance.WisataJogja.H1" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/playfair_semibold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/green_dark</item>
        <item name="android:lineSpacingMultiplier">1.02</item>
    </style>

    <style name="TextAppearance.WisataJogja.H2" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/playfair_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/green_dark</item>
    </style>

    <style name="TextAppearance.WisataJogja.H3" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/playfair_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/green_dark</item>
    </style>

    <style name="TextAppearance.WisataJogja.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="TextAppearance.WisataJogja.BodyStrong" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.WisataJogja.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="TextAppearance.WisataJogja.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.WisataJogja.Metric" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/playfair_semibold</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">@color/green_dark</item>
    </style>

    <style name="TextAppearance.WisataJogja.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="ShapeAppearance.WisataJogja.Rounded16" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.WisataJogja.Rounded14" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Widget.WisataJogja.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@color/green_dark</item>
        <item name="android:textColor">@color/cream_light</item>
        <item name="android:textAppearance">@style/TextAppearance.WisataJogja.Button</item>
        <item name="iconTint">@color/cream_light</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.WisataJogja.Button.Gold" parent="Widget.WisataJogja.Button">
        <item name="backgroundTint">@color/gold</item>
        <item name="android:textColor">@color/green_dark</item>
        <item name="iconTint">@color/green_dark</item>
    </style>

    <style name="Widget.WisataJogja.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/green_dark</item>
        <item name="android:textAppearance">@style/TextAppearance.WisataJogja.Button</item>
        <item name="iconTint">@color/green_dark</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.WisataJogja.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/cream_light</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/line</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="errorTextColor">@color/danger</item>
    </style>

    <style name="Widget.WisataJogja.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:background">@null</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="Widget.WisataJogja.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">24dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="android:textAppearance">@style/TextAppearance.WisataJogja.Caption</item>
        <item name="android:textStyle">bold</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Widget.WisataJogja.CategoryChip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/cream_light</item>
        <item name="android:textColor">@color/green_dark</item>
        <item name="chipStrokeColor">@color/line</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">30dp</item>
        <item name="android:textAppearance">@style/TextAppearance.WisataJogja.Label</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

</resources>
