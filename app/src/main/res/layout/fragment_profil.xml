<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="112dp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_admin_header"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="18dp"
            android:paddingBottom="54dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_tugu" />

                <com.example.wisatajogja.ui.common.SansTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/brand_name"
                    android:textAppearance="@style/TextAppearance.WisataJogja.Brand"
                    android:textSize="10sp" />

                <com.example.wisatajogja.ui.common.SansTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_green"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="6dp"
                    android:text="PROFIL"
                    android:textColor="@color/gold_light"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvatar"
                android:layout_width="106dp"
                android:layout_height="106dp"
                android:layout_marginTop="18dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/green_dark"
                app:cardCornerRadius="53dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/gold"
                app:strokeWidth="3dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imageAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_profile_photo"
                        android:scaleType="centerCrop" />

                    <FrameLayout
                        android:id="@+id/badgeCamera"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="2dp"
                        android:background="@drawable/bg_photo_badge">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_camera_alt"
                            app:tint="@color/green_dark" />
                    </FrameLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.example.wisatajogja.ui.common.SerifTextView
                android:id="@+id/textName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/playfair_semibold"
                android:textColor="@color/cream_light"
                android:textSize="24sp"
                tools:text="Nafisa Rahma" />

            <com.example.wisatajogja.ui.common.SansTextView
                android:id="@+id/textEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#B3FBF7EE"
                android:textSize="11sp"
                tools:text="nafisa@wisatajogja.id" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditProfile"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/profile_edit"
                android:textColor="@color/gold_light"
                android:textSize="11sp"
                app:icon="@drawable/ic_edit"
                app:iconSize="14dp"
                app:iconTint="@color/gold_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLoginGuest"
                style="@style/Widget.WisataJogja.Button.Gold"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/profile_guest_action"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStats"
            android:layout_width="0dp"
            android:layout_height="86dp"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="-32dp"
            app:cardBackgroundColor="@color/cream_light"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.example.wisatajogja.ui.common.SerifTextView
                        android:id="@+id/textVisited"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.WisataJogja.Metric"
                        android:textSize="22sp"
                        tools:text="12" />

                    <com.example.wisatajogja.ui.common.SansTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_trips"
                        android:textAppearance="@style/TextAppearance.WisataJogja.Caption" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="34dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.example.wisatajogja.ui.common.SerifTextView
                        android:id="@+id/textSaved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.WisataJogja.Metric"
                        android:textSize="22sp"
                        tools:text="2" />

                    <com.example.wisatajogja.ui.common.SansTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_saved"
                        android:textAppearance="@style/TextAppearance.WisataJogja.Caption" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="34dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.example.wisatajogja.ui.common.SerifTextView
                        android:id="@+id/textReviews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.WisataJogja.Metric"
                        android:textSize="22sp"
                        tools:text="8" />

                    <com.example.wisatajogja.ui.common.SansTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_reviews"
                        android:textAppearance="@style/TextAppearance.WisataJogja.Caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/menuContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardStats">

            <com.example.wisatajogja.ui.common.SansTextView
                android:id="@+id/textAccountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_menu_account"
                android:textAppearance="@style/TextAppearance.WisataJogja.Label" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAccountMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/cream_light"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="4dp">

                    <LinearLayout
                        android:id="@+id/rowEditProfile"
                        style="@style/Widget.WisataJogja.MenuRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_circle_cream">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_person"
                                app:tint="@color/green_dark" />
                        </FrameLayout>

                        <com.example.wisatajogja.ui.common.SansTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/profile_edit_profile"
                            android:textColor="@color/ink"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowChangePassword"
                        style="@style/Widget.WisataJogja.MenuRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_circle_cream">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_lock"
                                app:tint="@color/green_dark" />
                        </FrameLayout>

                        <com.example.wisatajogja.ui.common.SansTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/profile_change_password"
                            android:textColor="@color/ink"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowReservations"
                        style="@style/Widget.WisataJogja.MenuRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_circle_cream">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_confirmation_number"
                                app:tint="@color/green_dark" />
                        </FrameLayout>

                        <com.example.wisatajogja.ui.common.SansTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/profile_reservations"
                            android:textColor="@color/ink"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/muted" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.example.wisatajogja.ui.common.SansTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="PREFERENSI"
                android:textAppearance="@style/TextAppearance.WisataJogja.Label" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/cream_light"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="4dp">

                    <LinearLayout
                        style="@style/Widget.WisataJogja.MenuRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_circle_cream">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_notifications"
                                app:tint="@color/green_dark" />
                        </FrameLayout>

                        <com.example.wisatajogja.ui.common.SansTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/profile_notifications"
                            android:textColor="@color/ink"
                            android:textSize="13sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowHelp"
                        style="@style/Widget.WisataJogja.MenuRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_circle_cream">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_help"
                                app:tint="@color/green_dark" />
                        </FrameLayout>

                        <com.example.wisatajogja.ui.common.SansTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/profile_help"
                            android:textColor="@color/ink"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowPrivacy"
                        style="@style/Widget.WisataJogja.MenuRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_circle_cream">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_privacy_tip"
                                app:tint="@color/green_dark" />
                        </FrameLayout>

                        <com.example.wisatajogja.ui.common.SansTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/profile_privacy"
                            android:textColor="@color/ink"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowAdminPanel"
                        style="@style/Widget.WisataJogja.MenuRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_circle_gold">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_dashboard"
                                app:tint="@color/green_dark" />
                        </FrameLayout>

                        <com.example.wisatajogja.ui.common.SansTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/profile_admin_panel"
                            android:textColor="@color/green_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/muted" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLogout"
                style="@style/Widget.WisataJogja.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/profile_logout"
                android:textColor="@color/terracotta"
                app:icon="@drawable/ic_logout"
                app:iconTint="@color/terracotta"
                app:strokeColor="@color/line" />

            <com.example.wisatajogja.ui.common.SansTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/profile_version"
                android:textAppearance="@style/TextAppearance.WisataJogja.Caption"
                android:textColor="@color/muted_light" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
