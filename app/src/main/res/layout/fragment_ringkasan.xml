<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="112dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_admin_header"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_margin"
                android:paddingTop="18dp"
                android:paddingBottom="70dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="@string/app_name"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo_tugu" />

                    <com.example.wisatajogja.ui.common.SansTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="PANEL ADMIN"
                        android:textAppearance="@style/TextAppearance.WisataJogja.Brand"
                        android:textSize="10sp" />

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_gold">

                        <com.example.wisatajogja.ui.common.SansTextView
                            android:id="@+id/textAvatarInitial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="@color/green_dark"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="B" />
                    </FrameLayout>
                </LinearLayout>

                <com.example.wisatajogja.ui.common.SerifTextView
                    android:id="@+id/textGreeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/playfair_semibold"
                    android:textColor="@color/cream_light"
                    android:textSize="27sp"
                    tools:text="Halo, Bagas" />

                <com.example.wisatajogja.ui.common.SansTextView
                    android:id="@+id/textDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#B3FBF7EE"
                    android:textSize="11sp"
                    tools:text="Selasa, 17 November" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:layout_marginTop="-48dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/green_dark"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <com.example.wisatajogja.ui.common.SansTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/admin_visits_30"
                                android:textColor="#B3FBF7EE"
                                android:textSize="9sp" />

                            <com.example.wisatajogja.ui.common.SerifTextView
                                android:id="@+id/textVisitValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/playfair_semibold"
                                android:textColor="@color/cream_light"
                                android:textSize="25sp"
                                tools:text="24.861" />

                            <com.example.wisatajogja.ui.common.SansTextView
                                android:id="@+id/textVisitDelta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_tag_gold"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="2dp"
                                android:textColor="@color/green_dark"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                tools:text="+19%" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/cream_light"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/line"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <com.example.wisatajogja.ui.common.SansTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/admin_users_total"
                                android:textAppearance="@style/TextAppearance.WisataJogja.Caption"
                                android:textSize="9sp" />

                            <com.example.wisatajogja.ui.common.SerifTextView
                                android:id="@+id/textUsersValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/playfair_semibold"
                                android:textColor="@color/green_dark"
                                android:textSize="25sp"
                                tools:text="1.248" />

                            <com.example.wisatajogja.ui.common.SansTextView
                                android:id="@+id/textUsersDelta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/TextAppearance.WisataJogja.Caption"
                                android:textColor="@color/terracotta"
                                android:textSize="8sp"
                                tools:text="+135 bulan ini" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/cream_light"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/line"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <com.example.wisatajogja.ui.common.SansTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/admin_destinations_published"
                                android:textAppearance="@style/TextAppearance.WisataJogja.Caption"
                                android:textSize="9sp" />

                            <com.example.wisatajogja.ui.common.SerifTextView
                                android:id="@+id/textDestinationsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/playfair_semibold"
                                android:textColor="@color/green_dark"
                                android:textSize="25sp"
                                tools:text="8" />

                            <com.example.wisatajogja.ui.common.SansTextView
                                android:id="@+id/textDestinationsDelta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/TextAppearance.WisataJogja.Caption"
                                android:textSize="8sp"
                                tools:text="2 draf" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="112dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/gold"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <com.example.wisatajogja.ui.common.SansTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/admin_saved_total"
                                android:textColor="#B30C2E26"
                                android:textSize="9sp" />

                            <com.example.wisatajogja.ui.common.SerifTextView
                                android:id="@+id/textSavedValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/playfair_semibold"
                                android:textColor="@color/green_dark"
                                android:textSize="25sp"
                                tools:text="386" />

                            <com.example.wisatajogja.ui.common.SansTextView
                                android:id="@+id/textSavedDelta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#B30C2E26"
                                android:textSize="8sp"
                                tools:text="900 ulasan" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="@color/cream_light"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <com.example.wisatajogja.ui.common.SerifTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/admin_chart_title"
                            android:textAppearance="@style/TextAppearance.WisataJogja.H3" />

                        <com.example.wisatajogja.ui.common.SansTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_chart_subtitle"
                            android:textAppearance="@style/TextAppearance.WisataJogja.Caption" />
                    </LinearLayout>

                    <com.example.wisatajogja.ui.admin.ringkasan.BarChartView
                        android:id="@+id/chartView"
                        android:layout_width="match_parent"
                        android:layout_height="174dp"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/cream_light"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <com.example.wisatajogja.ui.common.SerifTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/admin_popular_title"
                            android:textAppearance="@style/TextAppearance.WisataJogja.H3" />

                        <com.example.wisatajogja.ui.common.SansTextView
                            android:id="@+id/actionManageDestinations"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="@string/admin_view_all"
                            android:textColor="@color/green_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.example.wisatajogja.ui.common.SansTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_popular_subtitle"
                        android:textAppearance="@style/TextAppearance.WisataJogja.Caption"
                        android:textSize="9sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerPopular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_admin_populer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/cream_light"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <com.example.wisatajogja.ui.common.SerifTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/admin_recent_users_title"
                            android:textAppearance="@style/TextAppearance.WisataJogja.H3" />

                        <com.example.wisatajogja.ui.common.SansTextView
                            android:id="@+id/actionManageUsers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="@string/admin_view_all"
                            android:textColor="@color/green_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerRecentUsers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_admin_pengguna_terbaru" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/cream_light"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.example.wisatajogja.ui.common.SerifTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_recent_reservations_title"
                        android:textAppearance="@style/TextAppearance.WisataJogja.H3" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerRecentReservations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_admin_reservasi" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:indeterminateTint="@color/green_dark" />

            <LinearLayout
                android:id="@+id/errorState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.example.wisatajogja.ui.common.SansTextView
                    android:id="@+id/textError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_error_network"
                    android:textAppearance="@style/TextAppearance.WisataJogja.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRetry"
                    style="@style/Widget.WisataJogja.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/common_retry" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
