<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <ImageButton
        android:id="@+id/buttonBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_circle_cream"
        android:contentDescription="@string/cd_back"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/green_dark" />

    <com.example.wisatajogja.ui.common.SansTextView
        android:id="@+id/textLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/crop_label"
        android:textAppearance="@style/TextAppearance.WisataJogja.Label"
        android:textColor="@color/terracotta"
        app:layout_constraintBottom_toBottomOf="@id/buttonBack"
        app:layout_constraintStart_toEndOf="@id/buttonBack"
        app:layout_constraintTop_toTopOf="@id/buttonBack" />

    <com.example.wisatajogja.ui.common.SerifTextView
        android:id="@+id/textCropTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginTop="12dp"
        android:text="@string/crop_title_profile"
        android:textAppearance="@style/TextAppearance.WisataJogja.H1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonBack" />

    <com.example.wisatajogja.ui.common.SansTextView
        android:id="@+id/textCropSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginTop="6dp"
        android:text="@string/crop_subtitle_profile"
        android:textAppearance="@style/TextAppearance.WisataJogja.Caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textCropTitle" />

    <FrameLayout
        android:id="@+id/cropContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_field_area"
        app:layout_constraintBottom_toTopOf="@id/zoomRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textCropSubtitle">

        <com.example.wisatajogja.ui.common.CropImageView
            android:id="@+id/cropView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/cropProgress"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/green_dark" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/zoomRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/actionRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cropContainer">

        <com.example.wisatajogja.ui.common.SansTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Geser foto untuk mengatur posisi"
            android:textAppearance="@style/TextAppearance.WisataJogja.Caption"
            android:textSize="10sp" />

        <ImageButton
            android:id="@+id/buttonZoomOut"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_cream"
            android:contentDescription="@string/crop_zoom_out"
            android:padding="10dp"
            android:src="@drawable/ic_remove"
            app:tint="@color/green_dark" />

        <ImageButton
            android:id="@+id/buttonZoomIn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_gold"
            android:contentDescription="@string/crop_zoom_in"
            android:padding="10dp"
            android:src="@drawable/ic_add"
            app:tint="@color/green_dark" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCancel"
            style="@style/Widget.WisataJogja.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/crop_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSave"
            style="@style/Widget.WisataJogja.Button.Gold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1.55"
            android:text="@string/crop_apply" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
