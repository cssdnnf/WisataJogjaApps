<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <com.example.wisatajogja.ui.common.SerifTextView
        android:id="@+id/textRank"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/playfair_semibold"
        android:gravity="center"
        android:textColor="@color/gold"
        android:textSize="17sp"
        tools:text="1" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="46dp"
        android:layout_height="46dp"
        app:cardBackgroundColor="@color/cream_deep"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/imageDestination"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.example.wisatajogja.ui.common.SansTextView
            android:id="@+id/textName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.example.wisatajogja.ui.common.SansTextView
            android:id="@+id/textArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.WisataJogja.Caption"
            android:textSize="9sp" />
    </LinearLayout>

    <com.example.wisatajogja.ui.common.SansTextView
        android:id="@+id/textSaved"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="3dp"
        android:textColor="@color/green_dark"
        android:textSize="10sp"
        android:textStyle="bold"
        app:drawableStartCompat="@drawable/ic_bookmark_small"
        app:drawableTint="@color/gold" />
</LinearLayout>
