<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="14dp"
            android:paddingBottom="36dp">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_cream"
                android:contentDescription="@string/cd_back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/green_dark" />

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="34dp"
                android:background="@drawable/bg_circle_gold">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/green_dark" />
            </FrameLayout>

            <com.example.wisatajogja.ui.common.SerifTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/forgot_title"
                android:textAppearance="@style/TextAppearance.WisataJogja.Display" />

            <com.example.wisatajogja.ui.common.SansTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/forgot_subtitle"
                android:textAppearance="@style/TextAppearance.WisataJogja.Body" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputEmailLayout"
                style="@style/Widget.WisataJogja.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:hint="@string/forgot_email"
                app:startIconDrawable="@drawable/ic_mail"
                app:startIconTint="@color/muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputEmail"
                    style="@style/Widget.WisataJogja.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSend"
                style="@style/Widget.WisataJogja.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/forgot_action" />

            <!--<com.example.wisatajogja.ui.common.SansTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_field_area"
                android:drawablePadding="10dp"
                android:padding="14dp"
                android:text="@string/forgot_demo_hint"
                android:textAppearance="@style/TextAppearance.WisataJogja.Caption"
                android:textColor="@color/muted" />-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.example.wisatajogja.ui.common.SansTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_remembered"
                    android:textAppearance="@style/TextAppearance.WisataJogja.Body" />

                <com.example.wisatajogja.ui.common.SansTextView
                    android:id="@+id/actionLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:padding="4dp"
                    android:text="@string/register_login"
                    android:textColor="@color/green_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
