<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_circle_cream">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_confirmation_number"
            app:tint="@color/green_dark" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.example.wisatajogja.ui.common.SansTextView
            android:id="@+id/textCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="WJ-261117-2048" />

        <com.example.wisatajogja.ui.common.SansTextView
            android:id="@+id/textMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.WisataJogja.Caption"
            android:textSize="9sp"
            tools:text="Nafisa · Goa Jomblang" />
    </LinearLayout>

    <com.example.wisatajogja.ui.common.SansTextView
        android:id="@+id/textStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_draf"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="@color/green_dark"
        android:textSize="8sp"
        android:textStyle="bold"
        tools:text="Menunggu" />
</LinearLayout>
