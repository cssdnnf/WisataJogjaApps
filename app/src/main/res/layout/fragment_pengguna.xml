<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.example.wisatajogja.ui.common.SansTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KOMUNITAS"
            android:textAppearance="@style/TextAppearance.WisataJogja.Label"
            android:textColor="@color/terracotta" />

        <com.example.wisatajogja.ui.common.SerifTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/users_title"
            android:textAppearance="@style/TextAppearance.WisataJogja.Display" />

        <com.example.wisatajogja.ui.common.SansTextView
            android:id="@+id/textSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.WisataJogja.Body"
            tools:text="1.248 akun terdaftar" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.WisataJogja.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/users_search_hint"
            app:endIconMode="clear_text"
            app:endIconTint="@color/muted"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputSearch"
                style="@style/Widget.WisataJogja.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/chipScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_margin"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.WisataJogja.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/users_filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipActive"
                style="@style/Widget.WisataJogja.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/users_filter_active" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipInactive"
                style="@style/Widget.WisataJogja.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/users_filter_inactive" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipScroll">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerUsers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="4dp"
                android:scrollbars="none"
            android:paddingBottom="130dp"
            tools:itemCount="5"
            tools:listitem="@layout/item_admin_pengguna" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_group"
                app:tint="@color/muted" />

            <com.example.wisatajogja.ui.common.SerifTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/users_empty_title"
                android:textAppearance="@style/TextAppearance.WisataJogja.H3" />

            <com.example.wisatajogja.ui.common.SansTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/users_empty_body"
                android:textAppearance="@style/TextAppearance.WisataJogja.Body" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/green_dark" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
