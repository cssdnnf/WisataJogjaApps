<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_cream"
                android:contentDescription="@string/cd_back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/green_dark" />

            <com.example.wisatajogja.ui.common.SansTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="RESERVASI"
                android:textAppearance="@style/TextAppearance.WisataJogja.Label"
                android:textColor="@color/terracotta" />

            <com.example.wisatajogja.ui.common.SerifTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/reservation_title"
                android:textAppearance="@style/TextAppearance.WisataJogja.Display" />

            <com.example.wisatajogja.ui.common.SansTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/reservation_subtitle"
                android:textAppearance="@style/TextAppearance.WisataJogja.Body" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/green_dark"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imageDestination"
                        android:layout_width="80dp"
                        android:layout_height="0dp"
                        android:contentDescription="@string/cd_destination_image"
                        android:scaleType="centerCrop"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.example.wisatajogja.ui.common.SerifTextView
                        android:id="@+id/textDestination"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="@font/playfair_semibold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/cream_light"
                        android:textSize="19sp"
                        app:layout_constraintBottom_toTopOf="@id/textDestinationMeta"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/imageDestination"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        tools:text="Pantai Timang" />

                    <com.example.wisatajogja.ui.common.SansTextView
                        android:id="@+id/textDestinationMeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="4dp"
                        android:drawablePadding="4dp"
                        android:textColor="#B3FBF7EE"
                        android:textSize="10sp"
                        app:drawableStartCompat="@drawable/ic_place"
                        app:drawableTint="@color/gold_light"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/imageDestination"
                        app:layout_constraintTop_toBottomOf="@id/textDestination"
                        tools:text="Gunungkidul · Rp30.000 / orang" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.example.wisatajogja.ui.common.SansTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/reservation_date"
                android:textAppearance="@style/TextAppearance.WisataJogja.Label" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDate"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/cream_light"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar_today"
                        app:tint="@color/green_dark" />

                    <com.example.wisatajogja.ui.common.SansTextView
                        android:id="@+id/textDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/reservation_date_hint"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.example.wisatajogja.ui.common.SansTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/reservation_people"
                android:textAppearance="@style/TextAppearance.WisataJogja.Label" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/cream_light"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <com.example.wisatajogja.ui.common.SansTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Jumlah pengunjung"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/buttonMinus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_cream"
                        android:contentDescription="@null"
                        android:padding="12dp"
                        android:src="@drawable/ic_remove"
                        app:tint="@color/green_dark" />

                    <com.example.wisatajogja.ui.common.SansTextView
                        android:id="@+id/textPeople"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/green_dark"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/buttonPlus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_gold"
                        android:contentDescription="@null"
                        android:padding="12dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/green_dark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.WisataJogja.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/reservation_notes"
                app:placeholderText="@string/reservation_notes_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputNotes"
                    style="@style/Widget.WisataJogja.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:maxLength="500" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/gold"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.example.wisatajogja.ui.common.SansTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reservation_summary"
                        android:textColor="@color/green_dark"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.example.wisatajogja.ui.common.SansTextView
                            android:id="@+id/textTicketLine"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="#B30C2E26"
                            android:textSize="12sp"
                            tools:text="Tiket × 2 orang" />

                        <com.example.wisatajogja.ui.common.SansTextView
                            android:id="@+id/textTicketTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/green_dark"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Rp60.000" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:background="#330C2E26" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.example.wisatajogja.ui.common.SansTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/reservation_total"
                            android:textColor="@color/green_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.example.wisatajogja.ui.common.SerifTextView
                            android:id="@+id/textGrandTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/playfair_semibold"
                            android:textColor="@color/green_dark"
                            android:textSize="20sp"
                            tools:text="Rp60.000" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/cream"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSubmit"
            style="@style/Widget.WisataJogja.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reservation_action" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
