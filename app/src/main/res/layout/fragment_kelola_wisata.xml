<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.example.wisatajogja.ui.common.SansTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KATALOG WISATA"
            android:textAppearance="@style/TextAppearance.WisataJogja.Label"
            android:textColor="@color/terracotta" />

        <com.example.wisatajogja.ui.common.SerifTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/manage_title"
            android:textAppearance="@style/TextAppearance.WisataJogja.Display" />

        <com.example.wisatajogja.ui.common.SansTextView
            android:id="@+id/textSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.WisataJogja.Body"
            tools:text="10 destinasi · 8 terbit · 2 draf" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.WisataJogja.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/manage_search_hint"
            app:endIconMode="clear_text"
            app:endIconTint="@color/muted"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputSearch"
                style="@style/Widget.WisataJogja.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/chipScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_margin"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.WisataJogja.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/common_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPublished"
                style="@style/Widget.WisataJogja.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_published" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDraft"
                style="@style/Widget.WisataJogja.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_draft" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipScroll">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDestinations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="4dp"
                android:scrollbars="none"
            android:paddingBottom="170dp"
            tools:itemCount="3"
            tools:listitem="@layout/item_admin_wisata" />

        <com.example.wisatajogja.ui.common.SansTextView
            android:id="@+id/textEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/manage_empty_body"
            android:textAppearance="@style/TextAppearance.WisataJogja.Body"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/green_dark" />
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/buttonAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="100dp"
        android:text="@string/manage_add"
        android:textColor="@color/green_dark"
        app:backgroundTint="@color/gold"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/green_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
